{
  "name": "@checkly/cli-monorepo",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm -r run prepack",
    "prepare": "pnpm exec simple-git-hooks",
    "sync:skills": "rimraf skills && cp -r packages/cli/dist/ai-context/public-skills/. skills",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r run test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lint-staged": "^16.4.0",
    "rimraf": "^6.1.4",
    "simple-git-hooks": "^2.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit",
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": "pnpm run lint"
  },
  "engines": {
    "pnpm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
